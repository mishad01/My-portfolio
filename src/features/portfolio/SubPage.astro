---
/** Standalone section page (canvas frames 2a–3c): no site header, a back link instead. */
import type { Lang } from '@/domain/types';
import { href } from '@/domain/i18n';
import { ui } from '@/i18n/ui';
import { button, layout, text } from '@/ui/classes';
import ThemeToggle from '@/features/portfolio/ThemeToggle';

interface Props { lang: Lang; id: string; tinted?: boolean; back?: boolean }
const { lang, id, tinted = false, back = true } = Astro.props;
const U = ui(lang);
---
<main id="main">
  <section id={id} class={layout.section + (tinted ? ' bg-surface-low' : '') + ' min-h-screen box-border'}>
    <div class={layout.container + ' gap-8'}>
      {back && (
        <div class="flex items-center justify-between gap-4">
          <a href={href(lang, '/') + '#' + id} class="flex h-10 items-center gap-2 rounded-[20px] pr-4 pl-3 text-sm font-medium text-primary no-underline hover:bg-surface-highest">
            <span class="ms text-xl">arrow_back</span>{U.backPortfolio}
          </a>
          <ThemeToggle client:load label={U.theme} />
        </div>
      )}
      <slot />
    </div>
  </section>
</main>
