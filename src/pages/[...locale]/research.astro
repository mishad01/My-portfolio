---
import Base from '@/layouts/Base.astro';
import SubPage from '@/features/portfolio/SubPage.astro';
import ResearchList from '@/features/portfolio/ResearchList';
import { loadPublished } from '@/data/content-repository';
import { localePaths } from '@/platform/locale-paths';
import { views } from '@/features/portfolio/view-model';
import { cls } from '@/ui/classes';
import type { Lang } from '@/domain/types';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const V = views(await loadPublished(), lang);
---
<Base lang={lang} path="/research/" title={`${V.U.nav.research} — Mishad`} description={V.research.map((r) => r.title).join(' · ')}>
  <SubPage lang={lang} id="research" tinted>
    <h2 class={cls.h2}>{V.U.nav.research}</h2>
    <ResearchList client:idle items={V.research} labels={V.moreLabels} />
  </SubPage>
</Base>
