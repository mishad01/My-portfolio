---
import Base from '@/layouts/Base.astro';
import SubPage from '@/components/SubPage.astro';
import ResearchList from '@/islands/ResearchList';
import { loadPublished } from '@/lib/content';
import { localePaths } from '@/lib/paths';
import { views } from '@/lib/view';
import { cls } from '@/lib/cls';
import type { Lang } from '@/lib/types';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const V = views(await loadPublished(), lang);
---
<Base lang={lang} path="/research/" title={`${V.U.nav.research} — Mishad`} description={V.research.map((r) => r.title).join(' · ')}>
  <SubPage lang={lang} id="research" tinted>
    <h2 class={cls.h2}>{V.U.nav.research}</h2>
    <ResearchList client:idle items={V.research} labels={V.moreLabels} />
  </SubPage>
</Base>
