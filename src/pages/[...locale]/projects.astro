---
import Base from '@/layouts/Base.astro';
import SubPage from '@/components/SubPage.astro';
import Projects from '@/islands/Projects';
import { loadPublished } from '@/lib/content';
import { localePaths } from '@/lib/paths';
import { views } from '@/lib/view';
import { cls } from '@/lib/cls';
import type { Lang } from '@/lib/types';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const V = views(await loadPublished(), lang);
---
<Base lang={lang} path="/projects/" title={`${V.U.nav.projects} — Mishad`} description={V.projects.map((p) => p.name).join(' · ')}>
  <SubPage lang={lang} id="projects" tinted>
    <h2 class={cls.h2}>{V.U.nav.projects}</h2>
    <Projects client:idle projects={V.projects} labels={V.projectLabels} />
  </SubPage>
</Base>
