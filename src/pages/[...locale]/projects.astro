---
import Base from '@/layouts/Base.astro';
import SubPage from '@/features/portfolio/SubPage.astro';
import Projects from '@/features/portfolio/Projects';
import { loadPublished } from '@/data/content-repository';
import { localePaths } from '@/platform/locale-paths';
import { views } from '@/features/portfolio/view-model';
import { button, layout, text } from '@/ui/classes';
import type { Lang } from '@/domain/types';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const V = views(await loadPublished(), lang);
---
<Base lang={lang} path="/projects/" title={`${V.U.nav.projects} — Mishad`} description={V.projects.map((p) => p.name).join(' · ')}>
  <SubPage lang={lang} id="projects" tinted>
    <h2 class={text.headline}>{V.U.nav.projects}</h2>
    <Projects client:idle projects={V.projects} labels={V.projectLabels} />
  </SubPage>
</Base>
