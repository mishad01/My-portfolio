---
import Base from '@/layouts/Base.astro';
import Portfolio from '@/features/portfolio/Portfolio.astro';
import { loadPublished } from '@/data/content-repository';
import { localePaths } from '@/platform/locale-paths';
import { t } from '@/domain/i18n';
import type { Lang } from '@/domain/types';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const content = await loadPublished();
const P = content.profile;
---
<Base lang={lang} path="/" title={`${P.fullName} — ${t(P.heroRole, lang).split(' · ')[0]}`} description={t(P.heroPos, lang)}>
  <Portfolio lang={lang} content={content} />
</Base>
