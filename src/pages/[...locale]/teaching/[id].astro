---
import Base from '@/layouts/Base.astro';
import Teaching from '@/islands/Teaching';
import { loadPublished } from '@/lib/content';
import { localePaths } from '@/lib/paths';
import { href, t } from '@/lib/i18n';
import { views } from '@/lib/view';
import { cls } from '@/lib/cls';
import type { Lang } from '@/lib/types';

export async function getStaticPaths() {
  const c = await loadPublished();
  return localePaths().flatMap((p) => c.classes.map((k) => ({ params: { ...p.params, id: k.id }, props: p.props })));
}
const { lang } = Astro.props as { lang: Lang };
const { id } = Astro.params;
const c = await loadPublished();
const V = views(c, lang);
const k = c.classes.find((x) => x.id === id)!;
---
<Base lang={lang} path={`/teaching/${id}/`} title={`${k.name} — Mishad`} description={k.desc}>
  <main id="main">
    <section id="teaching" class={cls.section + ' box-border min-h-screen'}>
      <div class={cls.inner}>
        <Teaching
          client:idle
          view="detail"
          sel={id}
          pagesBase={href(lang, '/teaching/')}
          classes={c.classes}
          platform={c.profile.teachPlatform}
          teachRole={t(c.profile.teachRole, lang)}
          topics={c.profile.teachTopics}
          title={V.U.nav.teaching}
          labels={V.teachLabels}
        />
      </div>
    </section>
  </main>
</Base>
