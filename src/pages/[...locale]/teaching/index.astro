---
import Base from '@/layouts/Base.astro';
import Teaching from '@/features/portfolio/Teaching';
import { loadPublished } from '@/data/content-repository';
import { localePaths } from '@/platform/locale-paths';
import { href, t } from '@/domain/i18n';
import { views } from '@/features/portfolio/view-model';
import { cls } from '@/ui/classes';
import type { Lang } from '@/domain/types';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const c = await loadPublished();
const V = views(c, lang);
---
<Base lang={lang} path="/teaching/" title={`${V.U.classes} — Mishad`} description={V.U.teachIntro}>
  <main id="main">
    <section id="teaching" class={cls.section + ' box-border min-h-screen'}>
      <div class={cls.inner}>
        <Teaching
          client:idle
          view="list"
          pagesBase={href(lang, '/teaching/')}
          backHref={href(lang, '/') + '#teaching'}
          classes={c.classes}
          platform={c.profile.teachPlatform}
          teachRole={t(c.profile.teachRole, lang)}
          topics={c.profile.teachTopics}
          title={V.U.nav.teaching}
          labels={V.teachLabels}
        />
      </div>
    </section>
  </main>
</Base>
