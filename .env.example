# Firebase web config (public — protection comes from Security Rules + App Check).
# Leave empty to run the admin in demo mode (edits kept in this browser only).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_APP_ID=
# reCAPTCHA v3 site key registered for App Check (optional but recommended).
PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Build-time only (GitHub Actions secret). Service-account JSON, single line.
# When unset, the site builds from src/data/seed.ts.
FIREBASE_SERVICE_ACCOUNT=
