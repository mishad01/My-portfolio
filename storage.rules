rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'V6M1bHaZYeenWANNdhTja1pybzd2';
    }
    // Project images, research figures, portrait, CV.
    match /uploads/{all=**} {
      allow read: if true;
      allow write: if isOwner()
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
