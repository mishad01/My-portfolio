rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace with your Firebase Auth UID (Authentication → Users).
    function isOwner() {
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_YOUR_UID';
    }

    // site/live is the published snapshot; site/draft is the admin's working copy.
    match /site/live {
      allow read: if true;
      allow write: if isOwner();
    }
    match /site/draft {
      allow read, write: if isOwner();
    }

    // Reserved for a future contact form: anyone can create, only you can read.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.message is string && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
